{
  "name": "ng-material-scaffold",
  "version": "0.0.44",
  "description": "Simple scaffold generated with `@angular/cli` then implemented manually.",
  "keywords": [
    "angular",
    "angular-material",
    "@angular",
    "@angular/material"
  ],
  "homepage": "https://github.com/SamuelMarks/ng-material-scaffold#readme",
  "bugs": "https://github.com/SamuelMarks/ng-material-scaffold/issues",
  "license": "(Apache-2.0 OR MIT)",
  "author": "Samuel Marks @SamuelMarks",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamuelMarks/ng-material-scaffold"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --code-coverage --watch=false",
    "lint": "eslint src/ && npm run doc-coverage",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css}\" \"tools/**/*.js\" \"eslint.config.js\" \"karma.conf.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css}\" \"tools/**/*.js\" \"eslint.config.js\" \"karma.conf.js\"",
    "doc-coverage": "node tools/doc-coverage.js",
    "update-shields": "node tools/update-shields.js",
    "coverage": "npm run doc-coverage && ng test --code-coverage --watch=false"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~6.0.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
